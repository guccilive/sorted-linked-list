{
    "name": "guccilive/sorted-linked-list",
    "description": "A type-safe, high-performance sorted linked list implementation for PHP",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Guccilive\\SortedLinkedList\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Guccilive\\SortedLinkedList\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Heritier Mashini",
            "email": "37352340+guccilive@users.noreply.github.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "2.1.x-dev",
         "squizlabs/php_codesniffer": "^4.0",
        "phpunit/phpunit": "^12.4"
    },
    "scripts": {
        "test": "vendor/bin/phpunit --stop-on-failure --order-by=defects",
        "cs": "vendor/bin/phpcs --standard=PSR12 src tests",
        "phpstan": "vendor/bin/phpstan analyse"
    }
}
